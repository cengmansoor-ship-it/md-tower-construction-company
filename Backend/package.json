{
  "name": "arabian-d-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "cd api-server && node --env-file=../.env --enable-source-maps ./dist/index.mjs",
    "reset:empty": "node --env-file=.env scripts/reset-empty-database.mjs --yes",
    "backup:mysql": "node --env-file=.env scripts/mysql-backup.mjs",
    "restore:latest": "node --env-file=.env scripts/restore-latest-backup.mjs"
  }
}
