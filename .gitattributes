# Normalize line endings for all text files.
* text=auto eol=lf

# Windows batch / PowerShell scripts must keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary

# Lockfiles are generated - keep them from cluttering diffs.
pnpm-lock.yaml  linguist-generated=true
